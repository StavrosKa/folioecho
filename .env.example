# Optional runtime server environment. The harness also reads its private config.
# Set this outside the repository; never expose it with a PUBLIC_ prefix.
QLOO_API_KEY=
# The local pilot fixes both endpoint variables in its server adapter.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Gemini demo server-only configuration. Never use a PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set free only after checking this Google project uses the Free tier.
# unknown conservatively estimates paid rates; never inferred from the key.
GEMINI_BILLING_TIER=unknown
# Optional legacy OpenAI private configuration. Personal keys are connected in Settings.
# Optional OpenAI server-only configuration. No real key belongs in this file.
# Alternatively run node scripts/setup-openai.mjs for private user configuration.
OPENAI_API_KEY=
OPENAI_MODEL=
# Hosted Netlify demo only. Set private values in the Netlify UI, never in Git.
FOLIOECHO_HOSTED=0
FOLIOECHO_SESSION_SECRET=
FOLIOECHO_QLOO_DAILY_LIMIT=300
FOLIOECHO_GEMINI_DAILY_LIMIT=20
FOLIOECHO_DEMO_DAILY_USD=0.05
